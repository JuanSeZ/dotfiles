#!/usr/bin/env bash

# Stowed into ~/.local/bin from the dotfiles bin package
session=$(find ~ ~/.config ~/bdk ~/voyager ~/infra ~/university -mindepth 1 -maxdepth 1 -type d | fzf)
# Esc in fzf leaves nothing to open
[[ -z $session ]] && exit 0
session_name=$(basename "$session" | tr . _)

if ! tmux has-session -t "$session_name" 2> /dev/null; then
    tmux new-session -s "$session_name" -c "$session" -d
fi

tmux switch-client -t "$session_name"

